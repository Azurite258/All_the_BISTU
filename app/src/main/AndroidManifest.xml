<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限：WebView 登录 + 调用教务系统接口都需要 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Study1"
        android:usesCleartextTraffic="false"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Study1"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 原生登录页（CAS + SM2） -->
        <activity
            android:name=".ui.login.NativeLoginActivity"
            android:exported="true"
            android:label="登录"
            android:theme="@style/Theme.Study1">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WebView 登录页 -->
        <activity
            android:name=".ui.login.WebViewLoginActivity"
            android:exported="false"
            android:label="登录(WebView)"
            android:theme="@style/Theme.Study1" />

        <!-- 动画演示页（验证用） -->
        <activity
            android:name=".ui.animation.AnimationDemoActivity"
            android:exported="false"
            android:label="动画验证"
            android:theme="@style/Theme.Study1" />

        <!-- Cookie 接口验证页（验证用） -->
        <activity
            android:name=".ui.login.CookieTestActivity"
            android:exported="true"
            android:label="Cookie验证"
            android:theme="@style/Theme.Study1">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>