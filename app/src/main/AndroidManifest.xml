<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限：WebView 登录 + 调用教务系统接口都需要 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Android 11+ 包可见性：不声明这个，代码里查不到微信装没装，
      weixin:// 的 resolveActivity 也会返回 null。只查微信，不查别的。
    -->
    <queries>
        <package android:name="com.tencent.mm" />
        <package android:name="com.tencent.wework" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="weixin" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="wxwork" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Study1"
        android:usesCleartextTraffic="false"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Study1"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 原生登录页（CAS + SM2） -->
        <activity
            android:name=".ui.login.NativeLoginActivity"
            android:exported="false"
            android:label="登录"
            android:theme="@style/Theme.Study1" />

        <!-- WebView 登录页（已废弃，保留备查） -->
        <activity
            android:name=".ui.login.WebViewLoginActivity"
            android:exported="false"
            android:label="登录(WebView)"
            android:theme="@style/Theme.Study1" />

        <!-- 动画演示页（验证用） -->
        <activity
            android:name=".ui.animation.AnimationDemoActivity"
            android:exported="false"
            android:label="动画验证"
            android:theme="@style/Theme.Study1" />

        <!-- Cookie 接口验证页（已废弃，保留备查） -->
        <activity
            android:name=".ui.login.CookieTestActivity"
            android:exported="false"
            android:label="Cookie验证"
            android:theme="@style/Theme.Study1" />
    </application>

</manifest>